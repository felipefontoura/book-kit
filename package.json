{
  "name": "book-kit",
  "private": true,
  "type": "module",
  "version": "1.0.0",
  "description": "Portable Markdown → PDF (Typst) + EPUB 3 book engine: print typography, KDP cover, Mermaid diagrams, LaTeX math, worksheets.",
  "license": "MIT",
  "author": "Felipe Fontoura (https://felipefontoura.com)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipefontoura/book-kit.git"
  },
  "scripts": {
    "render:diagrams": "node scripts/render-mermaid.mjs",
    "convert:typst": "node scripts/md-to-typst.mjs",
    "convert:epub": "node scripts/md-to-epub.mjs",
    "build": "bash scripts/build.sh",
    "build:pdf": "bash scripts/build.sh --pdf",
    "build:epub": "bash scripts/build.sh --epub",
    "example": "bash example/run.sh"
  },
  "devDependencies": {
    "@lesjoursfr/html-to-epub": "^4.1.5",
    "@mermaid-js/mermaid-cli": "^11.4.2",
    "archiver": "^7.0.1",
    "katex": "^0.16.47",
    "marked": "^15.0.7",
    "pagefind": "^1.5.2",
    "shiki": "^4.5.0",
    "subset-font": "^2.9.0",
    "yauzl": "^2.10.0"
  }
}
