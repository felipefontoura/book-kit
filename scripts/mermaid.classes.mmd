%% Kit semantic node classes — injected by render-mermaid.mjs into every
%% classDef-capable diagram (flowchart/graph, stateDiagram), right after the
%% header line. Use them with `class NodeA,NodeB accent;` in any book.
%% A book can add or override classes with its own mermaid.classes.mmd at the
%% book root (those lines are injected after these, and later wins in Mermaid;
%% classDefs written inline in a diagram win over both).
classDef accent fill:#E9CF95,stroke:#AD7A14,color:#14120F,stroke-width:3px;
classDef soft fill:#EFDFBB,stroke:#8C6210,color:#14120F;
classDef neutral fill:#ECE7DE,stroke:#B3A896,color:#14120F;
classDef muted fill:#F0EAE0,stroke:#CFC7BA,color:#5D564B;
